# 服务监听配置
HOST=0.0.0.0
PORT=7869
LOCAL_HOST=http://localhost:7869

# OpenAI api_base 和 api_key配置
OPENAI_API_KEY=123
OPENAI_API_BASE=https://api.openai.com/v1

# Chat模型配置
CHAT_MODEL_NAME=gpt-5.5

# Embedding模型配置
EMBEDDING_MODEL_NAME=qwen3-embedding

# elasticsearch配置
ES_URL=http://localhost:9200
ES_URSR=xxx
ES_PWD=xxx

# 向量库后端切换配置
# 可选：elasticsearch / pgsql
VECTOR_STORE_BACKEND=elasticsearch

# PostgreSQL 向量库配置
# 当 VECTOR_STORE_BACKEND=pgsql 时生效
PG_DATABASE_URL=postgresql://admin:admin@localhost:55432/deepclaw

# 对象存储配置
# 可选：local / minio；默认 local，目录语义为 LOCAL_STORAGE_ROOT/bucket_name/file_path
OBJECT_STORAGE_PROVIDER=local
# 留空时默认使用 .deepclaw/workspace/pdf_files
# LOCAL_STORAGE_ROOT=D:/deepclaw-data/objects
# 选择 minio 时必须完整配置以下连接参数
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 兼容已有部署：未配置 MINIO_ENDPOINT_URL 时可由服务地址生成
MINIO_SERVICE_ADDRESSES=

# tavily api_key配置
TAVILY_API_KEY=xxx

# 默认使用虚拟路径
# 后端类型 可选：local_shell, store, and sandbox
BACKEND_TYPE=store


# 是否使用copilotkit 的ag-ui 组件供前端使用
USE_COPILOTKIT=False

# 是否使用langsmith 配置
# LANGSMITH_API_KEY=...

# 是否支持工具搜索功能,（与 Claude Code 保持一致）
USE_TOOL_SEARCH=False

# MCP 服务配置，值为 JSON；无默认 MCP 服务时保持空对象
MCP_CONFIG={}

# AG-UI Run 与事件流保留配置
AGUI_RUN_RETENTION_SECONDS=3600
AGUI_THREAD_RETENTION_SECONDS=0
AGUI_RUN_MAX_EVENTS=2000
AGUI_RUN_CLEANUP_INTERVAL_SECONDS=60
AGUI_RUN_POLL_INTERVAL_SECONDS=0.5


# 使用 phoenix 可观测性组件
PHOENIX_COLLECTOR_ENDPOINT='http://localhost:6006'

# Channel gateway
# 可选：完整覆盖渠道 Agent AG-UI Runs URL；留空时自动使用 /api/agui/runs
# CHANNEL_AGENT_API_URL=http://127.0.0.1:7869/api/agui/runs

# Weixin ClawBot channel
WEIXIN_CLAWBOT_API_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CLAWBOT_AUTO_POLL_ON_STARTUP=True
WEIXIN_CLAWBOT_DEFAULT_REPLY_MODE=streaming
WEIXIN_CLAWBOT_LOGIN_POLL_INTERVAL_SECONDS=2.0
WEIXIN_CLAWBOT_MESSAGE_POLL_INTERVAL_SECONDS=1.0

# 微信 ClawBot 新会话默认回复模式，可选：streaming / final
WEIXIN_CLAWBOT_DEFAULT_REPLY_MODE=streaming


AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=Admin123456
AUTH_TOKEN_EXPIRE_DAYS=1
