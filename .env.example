# ============================================================================
# 经常修改：按部署环境 / 新接入的外部服务调整
# ============================================================================

# 服务监听配置
HOST=0.0.0.0
PORT=7869
LOCAL_HOST=http://localhost:7869

# OpenAI api_base 和 api_key配置
# 四项模型配置均可留空：留空时启动不再报错，改在前端「模型配置」页维护模型目录
OPENAI_API_KEY=123
OPENAI_API_BASE=https://api.openai.com/v1

# Chat模型配置
CHAT_MODEL_NAME=gpt-5.5
# 模型上下文窗口长度，用于按 80% 阈值触发摘要；按实际部署模型调整
MODEL_CONTEXT_WINDOW=256000

# Embedding模型配置
EMBEDDING_MODEL_NAME=qwen3-embedding

# tavily api_key配置
TAVILY_API_KEY=xxx

# elasticsearch配置
ES_URL=http://localhost:9200
ES_URSR=xxx
ES_PWD=xxx

# 向量库后端切换配置
# 可选：elasticsearch / pgsql
VECTOR_STORE_BACKEND=pgsql

# PostgreSQL 向量库配置
# 当 VECTOR_STORE_BACKEND=pgsql 时生效
PG_DATABASE_URL=postgresql://admin:admin@localhost:5432/deepclaw
# 未设置 PG_DATABASE_URL 时使用统一的业务元数据 SQLite。相对路径以 DEEPCLAW_HOME 为基准。
# SQLITE_DB_PATH=deepclaw.db

# 对象存储配置
# 可选：local / minio；默认 local，目录语义为 LOCAL_STORAGE_ROOT/bucket_name/file_path
OBJECT_STORAGE_PROVIDER=local
# 留空时默认使用 .deepclaw/workspace/object_storage
# LOCAL_STORAGE_ROOT=D:/deepclaw-data/objects
# 选择 minio 时必须完整配置以下连接参数
MINIO_ENDPOINT_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 兼容已有部署：未配置 MINIO_ENDPOINT_URL 时可由服务地址生成
MINIO_SERVICE_ADDRESSES=

# Channel gateway
# 可选：完整覆盖渠道 Agent AG-UI Runs URL；留空时自动使用 /api/agui/runs
# CHANNEL_AGENT_API_URL=http://127.0.0.1:7869/api/agui/runs
# 渠道 Agent HTTP 连接/读取超时与 SSE 断流重试次数
CHANNEL_AGENT_CONNECT_TIMEOUT_SECONDS=10
CHANNEL_AGENT_READ_TIMEOUT_SECONDS=90
CHANNEL_AGENT_STREAM_RETRIES=3

# Weixin ClawBot channel
WEIXIN_CLAWBOT_API_BASE_URL=https://ilinkai.weixin.qq.com

# 管理员账号
AUTH_ADMIN_USERNAME=deepclaw
AUTH_ADMIN_PASSWORD=deepclaw
# 可选：管理员邮箱，仅作展示，不参与登录
AUTH_ADMIN_EMAIL=
AUTH_TOKEN_EXPIRE_DAYS=1
# 是否开放公开注册；默认关闭，账号由管理员创建
AUTH_ALLOW_REGISTRATION=false
# 是否允许未登录游客访问；公网部署请改为 false，强制登录
ALLOW_GUEST_ACCESS=true
# 连续登录失败达到阈值后锁定账号的分钟数
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15


# ============================================================================
# 一般不变：保持默认即可，仅在需要调整行为时修改
# ============================================================================

# 单实例知识文件后台并发数（1-8，默认 2）
KNOWLEDGE_UPLOAD_WORKERS=5

# RAG 检索最终交给模型的切片数量（1-100，默认 15）；单路候选量为 max(RAG_TOP_K * 4, 20)
RAG_TOP_K=15

# 默认使用虚拟路径
# 后端类型 可选：local_shell, store, and sandbox
BACKEND_TYPE=store

# 是否使用copilotkit 的ag-ui 组件供前端使用
USE_COPILOTKIT=False

# 是否使用langsmith 配置
# LANGSMITH_API_KEY=...

# 是否支持工具搜索功能,（与 Claude Code 保持一致）
USE_TOOL_SEARCH=False

# MCP 服务配置，值为 JSON；无默认 MCP 服务时保持空对象
MCP_CONFIG={}

# AG-UI Run 与事件流保留配置
AGUI_RUN_RETENTION_SECONDS=3600
AGUI_THREAD_RETENTION_SECONDS=0
AGUI_RUN_MAX_EVENTS=2000
AGUI_RUN_CLEANUP_INTERVAL_SECONDS=60
AGUI_RUN_POLL_INTERVAL_SECONDS=0.5
# 单次智能体运行允许执行的步数，默认与 LangGraph 官方值一致
AGUI_RUN_RECURSION_LIMIT=10007

# 使用 phoenix 可观测性组件
PHOENIX_COLLECTOR_ENDPOINT='http://localhost:6006'

# 微信 ClawBot 新会话默认回复模式，可选：streaming / final
WEIXIN_CLAWBOT_DEFAULT_REPLY_MODE=streaming
WEIXIN_CLAWBOT_AUTO_POLL_ON_STARTUP=True
WEIXIN_CLAWBOT_LOGIN_POLL_INTERVAL_SECONDS=2.0
WEIXIN_CLAWBOT_MESSAGE_POLL_INTERVAL_SECONDS=1.0
