# openAI api_base 和 api_key配置
OPENAI_API_KEY=123
OPENAI_API_BASE=http://localhost:8082/v1

# Chat模型配置
CHAT_MODEL_NAME=qwen3

# Embedding模型配置
EMBEDDING_MODEL_NAME=qwen3-embedding

# elasticsearch配置
ES_URL=http://localhost:9200
ES_URSR=xxx
ES_PWD=xxx

# tavily api_key配置
TAVILY_API_KEY=xxx

# 默认使用虚拟路径
# 后端类型 可选：local_shell, store, and sandbox
BACKEND_TYPE=store


# 是否使用copilotkit 的ag-ui 组件供前端使用
USE_COPILOTKIT=False

# 是否使用langsmith 配置
# LANGSMITH_API_KEY=...

# 是否支持工具搜索功能,（与 Claude Code 保持一致）
USE_TOOL_SEARCH=False

# 使用 phoenix 可观测性组件
PHOENIX_COLLECTOR_ENDPOINT='http://localhost:6006'

# Channel gateway
CHANNEL_AGENT_API_URL=http://127.0.0.1:7869/api/agent/general_api

# Weixin ClawBot channel
WEIXIN_CLAWBOT_API_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CLAWBOT_AUTO_POLL_ON_STARTUP=True
WEIXIN_CLAWBOT_DEFAULT_REPLY_MODE=streaming
WEIXIN_CLAWBOT_LOGIN_POLL_INTERVAL_SECONDS=2.0
WEIXIN_CLAWBOT_MESSAGE_POLL_INTERVAL_SECONDS=1.0

# 微信 ClawBot 新会话默认回复模式，可选：streaming / final
WEIXIN_CLAWBOT_DEFAULT_REPLY_MODE=streaming


AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=Admin123456
AUTH_TOKEN_EXPIRE_DAYS=1
